# ==============================================================================
# SILE Backend Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="Smart Inclusive Learning Ecosystem (SILE) API"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"

# Server
HOST="0.0.0.0"
PORT=8000
ALLOWED_HOSTS=["*"]

# CORS (JSON Array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & JWT (Change in production!)
SECRET_KEY="generate_a_secure_random_secret_key_for_jwt_tokens_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="sile_user"
POSTGRES_PASSWORD="sile_secure_password"
POSTGRES_DB="sile_db"

# Optional direct async connection string (overrides the components above if provided)
DATABASE_URL="postgresql+asyncpg://sile_user:sile_secure_password@localhost:5432/sile_db"
